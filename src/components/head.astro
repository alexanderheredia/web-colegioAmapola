---
import Logo from "../assets/icons/logo.png"
import Menu from "../assets/icons/menu.ico"
---

<header class="head">

    <div class="logo">
        <div class="logo-img">
            <img src={Logo.src} alt="">
        </div>
    </div>


    <nav class="navegacion">
        
        <ul class="ul-head" id="menuList">
            <li class="li-head"><a href="/">Inicio</a></li>
            <li class="li-head"><a href="/admisiones">Admisiones</a></li>
            <li class="li-head"><a href="/about">Sobre nosotros</a></li>
            <li class="li-head"><a href="/contact">Contactanos</a></li>

        </ul>
        
        <div class="menu" >
            <details>
                <summary><img src={Menu} alt=""></summary>
                <ul class="ul-head-responsive" id="menuList">
                    <li class="li-head"><a href="/">Inicio</a></li>
                    <li class="li-head"><a href="/admisiones">Admisiones</a></li>
                    <li class="li-head"><a href="/about">Sobre nosotros</a></li>
                    <li class="li-head"><a href="/contact">Contactanos</a></li>
                </ul>
            </details>
            
        </div>

    </nav>

</header>

<style>

   

    .head{
        display: flex;
        justify-content: space-between;
        background: #081d70;
        background: radial-gradient(circle, rgba(8, 29, 112, 1) 0%, rgba(31, 63, 99, 1) 100%);
        align-items: center;
        border-bottom: 2px solid white;
        position: sticky;
        top: 0;
        width: 100%;
        z-index: 21;
    }

    .logo{
        display: flex;
        align-items: center;
        margin-left: 35px;
        margin-top: 15px;
        margin-bottom: 15px;
    }

    .logo img{width: 100px;}

    .menu{ 
        display: none; 
        margin-right: 40px;
        user-select: none;
        height: 100%;
    }

    .menu img{
        width: 45px;
        height: 35px;    
    }

    summary{list-style: none;}

    nav .ul-head{
        display: flex;
        flex-direction: row;
        list-style: none;
        align-items: center;
        margin-right: 15px;
    }

    .li-head{padding: 15px 0;}

    .li-head a{
        font-size: 20px;
        cursor: pointer;
        padding: 10px 20px;
        font-weight: bolder;
        transition: 0.3s;
    }

    .li-head a{
        text-decoration: none;
        color: white;
        user-select: none;

    }

    .li-head a:hover{text-decoration: underline #ee3c3b;}

    .li-head a:active{color: rgb(210, 209, 209);}

    /* Responsive */


    @media(max-width: 860px){

        nav  .ul-head-responsive{ 
            text-align: center;
            flex-direction: column;
            position: absolute;
            top: 125px;
            right: 0;
            left: 0px;
            padding: 20px;
            padding-bottom: 20px;
            line-height: 30px;
            background-color: rgb(255, 255, 255);
            border: 2px solid black;
        }

        nav .ul-head{display: none;}

        .li-head{list-style: none;}

        .li-head a{
            font-size: 20px;
            cursor: pointer;
            padding: 10px 20px;
            font-weight: bolder;
            border-radius: 30px;
            transition: 0.1s;
        }

        .li-head a{
            text-decoration: none;
            color: rgb(0, 0, 0);
            user-select: none;
        }

        .li-head a:hover{
            border: none;
            text-decoration: underline #e23939;
        }

        .li-head a:active{
            color: rgb(210, 209, 209);
            border: none;
        }

        .menu{
            display: block;
            cursor: pointer;
            transition: 0.2s;
            padding: 10px;
            padding-bottom: -5px;
        }

    }

</style>



