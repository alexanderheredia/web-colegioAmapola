---
import Layout from "../layouts/layouts.astro"
// Imagenes
import Logo from "../assets/icons/logo.png"
import Relleno from "../assets/index-image/relleno.png"
import Vista from "../assets/index-image/vista-previa.png"
import Ubicacion from "../assets/index-image/ubicacion.jpg"
---

<Layout>

		<section class="inicio">

			<section class="bgc">
	
				<div class="main-page">
					<div class="presentation">
						<img src={Logo.src} alt="">
					</div>
					 
					<div class="title">
						<h1 id="title">Colegio Amapola</h1>
						<h3 id="lema">Educando para el futuro</h3>
					</div>
				</div>
		 
			</section>
		 
		 
			<section class="relleno">

				<div class="back">
					<div class="relleno-text">
						<h1>Bienvenidos al Colegio Amapola</h1><br>
						<p>Bienvenidos a nuestra oferta academica donde pueden brindarles una direccion para el aprendisaje de su hij@ y darles la mejor educacion que se les puede dar en todo Los Mina</p>
					 </div>
	
					 <div class="img-relleno">
						<img src={Relleno.src} alt="">
					 </div>
				</div>

			</section>

			<section class="relleno2">

				<div class="ancho">
					<div class="img-relleno2">
						<img src={Vista.src} alt="">
				   </div>
	
					<div class="back">
						<div class="relleno-text2">
	
							<p>Pueden disfrutar de nuestras Instalaciones donde contamos con amplias aulas, cancha, camaras de seguridad, etc.</p>
		
						</div>
		
						<div class="btn-relleno2">
							<a href="/actividades"><button>Ver mas</button></a>
						</div>
		
					</div>
				</div>
				
			</section>

			<section class="ubicacion">
		 
				<div class="direccion">
					<h1>Direccion:</h1>
					<p>
						Pueden encontrarnos en nuestras <a href="#">Instalaciones</a>, la cual esta ubicada en <a href="https://www.google.com/maps/dir/18.5108636,-69.8478165/18.5193708,-69.8567605/@18.5144048,-69.8610099,15z/data=!3m1!4b1!4m4!4m3!1m1!4e1!1m0?entry=ttu" target="_blank" >Av. Trinitaria No. 28, Cancino 1, 
						Santo Domingo Este, Rep Dom.</a>
					</p>
					<a href="https://www.google.com/maps/dir/18.5108636,-69.8478165/18.5193708,-69.8567605/@18.5144048,-69.8610099,15z/data=!3m1!4b1!4m4!4m3!1m1!4e1!1m0?entry=ttu" 
					target="_blank" >
						<button>Ver mapa</button>
					</a>
				</div>
		 
		 
				<div class="map">
					<img src={Ubicacion.src} alt="">
				</div>
		 
			</section>
	
		</section>



</Layout>

<style>

	.inicio{overflow: hidden;}

	.bgc{
		background-image: url("../assets/index-image/main-fondo.jpg");
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
		height: 100%;
		opacity: .8;
	}
	
	.main-page{
		padding: 95px 0;
		display: flex;
		justify-content:  center;
		align-items: center;
	}

	.presentation img{width: 300px;}

	.title{margin-right: 35px;}

	#title{
		font-size: 85px;
		margin-bottom: -90px;
		color: rgb(255, 255, 255);
	}

	#lema{
		font-size: 68px; 
		color: white;
	}


	.relleno{
		padding: 25px;
		background: #081d70;
		background: radial-gradient(circle, rgba(8, 29, 112, 1) 0%, rgba(31, 63, 99, 1) 100%);
		box-shadow: inset 0px 7px 48px -21px rgba(59,66,123,1);
	}

	.back{
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-bottom: 100px;
	}

	.relleno-text{
		background-color: rgb(229, 232, 232);
		color: rgb(51, 51, 51);
		padding: 55px;
		border-radius: 5px;
		max-width: 1995px;
	
	}
	.relleno-text h1{
		font-size: 40px;
		font-style: italic;
	}

	.relleno-text p{font-size: 22px;}

	.img-relleno img{
		width: 390px;
		margin-left: 50px;
	}

	.relleno2{
		background: rgba(59,67,123,1);
		box-shadow: inset 0px 7px 48px -21px rgba(59,66,123,1);
		text-align: center;
		width: 100%;
		padding: 50px 0px;
	}

	.ancho{
		display: flex;
		justify-content: space-between;
	}

	.relleno2 .back{
		background-color: rgb(229, 232, 232);
		color: rgb(51, 51, 51);
		font-weight: bold;
		flex-direction: column;
		align-items: end;
		padding: 55px;
		border-radius: 5px;
		max-width: 1295px;
		margin-bottom: 50px;
		margin-right: 25px;
		margin-left: 45px;
		
	}

	.relleno-text2{
		font-size: 25px;
		margin-bottom: 95px;
	}

	.btn-relleno2 button{
		padding: 5px 35px;
		border-radius: 55px;
		font-size: 20px;
		font-weight: bold;
		cursor: pointer;
		border: 2px #5c5d61 solid;
		transition: 0.5s;
	}

	.btn-relleno2 button:hover{
		background-color: #5c5d61;
		color: white;
	}

	.btn-relleno2 button:active{background-color: #494a4d;}

	.img-relleno2{
		display: flex;
		flex-direction: column;
	}

	.img-relleno2 img{
		width: 500px;
		border: 2px #fff solid;
		border-radius: 10px;
		margin-left: 25px;
	
	}

	.ubicacion{
		margin: 105px 0;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.direccion{
		margin-right: 110px;
		max-width: 500px;
	}

	.map img{border-radius: 45px;}

	.direccion h1{font-size: 40px;}

	.direccion p{font-size: 20px;}

	.direccion button{
		font-size: 20px;
		font-weight: bold;
		padding: 5px 25px;
		border-radius: 30px;
		border: 3px black solid;
		margin-top: 15px;
		background-color: white;
		cursor: pointer;
		transition: 0.3s;
	}

	.direccion button a{
		text-decoration: none;
		color: black;
	}

	.direccion button:hover{color: white;}

	.direccion button:hover{
		border: rgb(185, 182, 182) solid;
		background-color: #3B437B;
	}

	.direccion button:active{
		color: rgb(174, 171, 171);
		background-color: #313765;
	}

	/* Responsive */

	@media(min-width: 1710px){

		.relleno{
			padding: 25px 55px;
			background: rgb(233,60,61);
			background: linear-gradient(180deg, rgba(233,60,61,1) 70%, rgba(59,67,123,1) 100%);
			box-shadow: inset 0px 7px 48px -21px rgba(59,66,123,1);

		}

		.back{
			display: flex;
			justify-content: space-between;
			align-items: center;
			border-radius: 15px;
			margin: 0px 120px;
		}

		.relleno-text{
			background-color: rgb(229, 232, 232);
			color: rgb(51, 51, 51);
			padding: 55px;
			border-radius: 5px;
			max-width: 1295px;
		
		}
		.relleno-text h1{
			font-size: 45px;
			font-style: italic;
		}

		.relleno-text p{font-size: 22px;}

		.img-relleno img{width: 390px;}

		.relleno2{display: block;}

		.ancho{
			max-width: 2195px;
			margin: 0 auto;
		}

	}

	@media(max-width:1200px) {
		
		.relleno img{display: none;}

		.relleno2 img{display: none;}

		.relleno2 .back{
			margin-right: 25px;
			margin-left: 25px;
		}
		
		.direccion{width: 380px;}

		.map img{
			width: 400px;
			border-radius: 45px;
		}
	}
	
	@media(max-width: 1080px){
		
		.presentation img{width: 200px;}

		#title{font-size: 65px;}

		#lema{font-size: 48px;}

		.direccion{
			text-align: center;
			width: 500px;
			margin-right: 5px;
		}

		.map img{display: none;}

		.direccion h1{font-size: 35px;}

		.direccion p{
			margin-top: 10px;
			font-size: 20px;
		}

	}

	@media(max-width:910px){

		#title{margin-bottom: -50px;}

	}

	@media (max-width: 860px){

		.img-relleno, 
		.img-relleno2{display:none;}

		.relleno-text h1{font-size: 35px;}

		.relleno-text p{font-size: 20px;}

		.relleno2 .back{
			margin-right: 25px;
			margin-left: 25px;
		}

		.map{display: none;}
	}

	@media(max-width: 760px){

		.main-page{
			display: flex;
			justify-content:  center;
			align-items: center;
		}

		.title{margin-left: 35px;}

		#title{font-size: 45px;}

		#lema{font-size: 35px;}

	}

	@media(max-width: 670px){
		
		.relleno-text h1{text-align: center;}
    }

	@media(max-width: 660px){
		.main-page{
			flex-direction: column;
			text-align: center;
		}

	}

	@media(max-width: 400px){
		
		.title{margin: 0 auto;}

		#title{font-size: 45px;}

		#lema{font-size: 30px;}

		.relleno-text{
			background-color: rgb(229, 232, 232);
			color: rgb(51, 51, 51);
			padding: 55px;
			border-radius: 5px;
			max-width: 1995px;
		
		}
		.relleno-text h1{
			font-size: 25px;
			font-style: italic;
		}

		.relleno-text p{
			font-size: 17px;
			text-align: center;
		}

		.relleno-text2{
			font-size: 20px;
			margin-bottom: 95px;
		}

		.ubicacion{
			margin-top: 105px ;
			display: flex;
			text-align: center;
		}

	}


</style>