---
import Layout from "../layouts/layouts.astro" 
// imgenes
import Insta from "../assets/contact-img/instagram.webp"
import Face from "../assets/contact-img/facebook.webp"
import Gmail from "../assets/icons/gmail.png"
import Whats from "../assets/icons/whatsapp.png"
---

<Layout>

     <section class="contact">

        <div class="redes">

            <div class="title">
                <h1>Redes sociales</h1>
                <p>
                    Pueden buescar mas informacion en nuestras redes sociales, donde subimos contenido referente a actividades, festividades y de mas:
                </p>
            </div>

            <div class="flex">
                <div class="facebook">
                    <a href="https://web.facebook.com/colegioamapola/about_contact_and_basic_info?locale=es_LA" target="_blank"><img src={Face.src} alt="" ></a>
                    <p>Facebook:</p>
                    <a href="https://web.facebook.com/colegioamapola/about_contact_and_basic_info?locale=es_LA" target="_blank">Colegio Amapola</a>
                </div>
    
                <div class="insta">
                    
                    <a href="https://www.instagram.com/colegioamapola/?hl=es" target="_blank"><img src={Insta.src} alt=""></a>
                    <p>Instagram:</p>
                    <a href="https://www.instagram.com/colegioamapola/?hl=es" target="_blank">@colegioamapola</a>
    
                </div>

                <div class="whats">

                    <img src={Whats.src} alt="">
                    <p>Whatsapp:</p>
                    <span>849-408-7985</span>
    
                </div>
                
                <div class="email">
                    
                    <a href="https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox?compose=GTvVlcSGLPkQWRpdlMJwWzqBxvHfmdSXXldlGnNJQsjDvhxSQfxPQbTqGghQDMRSkNPPgMWFxdtTq" target="_blank"></a><img src={Gmail.src} alt=""></a>
                    <p>Correo electornico:</p>
                    <a href="https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox?compose=GTvVlcSGLPkQWRpdlMJwWzqBxvHfmdSXXldlGnNJQsjDvhxSQfxPQbTqGghQDMRSkNPPgMWFxdtTq" target="_blank">Info@colegioamapola.com</a>
                </div>
            </div>

        </div>


    </section>

    
</Layout>

<style>

    .contact{
        padding: 55px;
        background-color: rgb(115, 115, 115);
    }

    .redes{
        background-color: white;
        padding: 45px;
        border-radius: 15px;
    }

    .title{
        margin-bottom: 145px;
        text-align: center;
        font-size: 45px;
    }

    .title h1{
        margin-bottom: 15px;
        font-style: italic;
        color: rgb(59, 59, 59);
    }

    .title p{
        font-size: 25px;
        font-weight: 100px;
    }

    .flex{
        display: flex;
        justify-content: space-between;
        text-align: center;
        align-items: center;
        overflow: hidden;
        padding: 0 35px;
    }

    .flex
    .facebook p,
    .insta p,
    .whats p,
    .email p{
        font-weight: bold;
        letter-spacing: 5px;
        font-size: 20px;
        font-style: italic;
    }


    .facebook img{width: 70px;}

    .insta img{ width: 40px;}

    .whats img{width: 40px;}

    .email img{width: 40px;}
    
    span, 
    .facebook a, 
    .insta a, 
    .email a{
        text-decoration: underline;
        font-size: 17px;
        color: black;
        padding: 0 2px;
        cursor: pointer;
    }

    

    /* Responsive */

    @media(max-width: 860px) {
        
        .title{margin-bottom: 65px;}

        .flex{display: block;}

        .facebook,
        .insta,
        .whats,
        .email{
            margin-bottom: 25px;
        } 

        .relleno{padding: 150px 50px;}
    }

    @media(max-width: 400px){
        
        .title{font-size: 25px;}

        .title p{font-size: 20px;}

        .flex{
            text-align: start;
            padding: 0;
        }
       
    }

</style>